#!/usr/bin/env bash
# boxctl-claude -- the Claude Code plugin's one helper. Remembers which
# box a project's Bash commands go to, and runs them there.
#
#   boxctl-claude on [box] [boxctl create flags...]   route this project's Bash to a box
#   boxctl-claude off                                 back to local bash
#   boxctl-claude status                              which box, if any, and its state
#   boxctl-claude box                                 just the box name (no network)
#   boxctl-claude run <timeout-seconds> <cwd> <base64-command>
#                                                     (used by the hook) run one command
#
# State is one file per project under ~/.boxctl/claude/, holding the box
# name, keyed by a hash of the project directory -- so it survives
# restarting Claude Code, and different projects can use different boxes.
set -euo pipefail

state_dir="${HOME}/.boxctl/claude"

project_dir() {
	printf '%s' "${CLAUDE_PROJECT_DIR:-$PWD}"
}

state_file() {
	local key
	key="$(project_dir | shasum -a 256 | cut -c1-16)"
	printf '%s/%s' "$state_dir" "$key"
}

# current_box prints the box this project routes to, or nothing.
current_box() {
	local f
	f="$(state_file)"
	[[ -f "$f" ]] && head -n1 "$f"
	return 0
}

box_state() {
	boxctl ls 2>/dev/null | awk -v n="$1" 'NR > 1 && $1 == n { print $2 }'
}

# ensure_running resumes a paused box; boxctl's exec endpoint refuses
# anything that isn't running and ready.
ensure_running() {
	local box="$1" state
	state="$(box_state "$box")"
	case "$state" in
	running) ;;
	paused)
		echo "boxctl: resuming paused box $box..." >&2
		boxctl resume "$box" >&2
		;;
	"")
		echo "boxctl: box $box not found (boxctl ls); run /boxctl:on again" >&2
		return 1
		;;
	*)
		echo "boxctl: box $box is $state" >&2
		;;
	esac
}

cmd_on() {
	local box="${1:-}"
	[[ $# -gt 0 ]] && shift
	if [[ -z "$box" ]]; then
		box="claude-$(basename "$(project_dir)" | tr -c 'a-zA-Z0-9-' '-' | tr '[:upper:]' '[:lower:]' | cut -c1-20 | sed 's/-*$//')"
	fi
	if [[ -z "$(box_state "$box")" ]]; then
		echo "Creating box $box (this takes a minute or two)..."
		boxctl create "$box" "$@"
	else
		ensure_running "$box"
	fi
	mkdir -p "$state_dir"
	printf '%s\n%s\n' "$box" "$(project_dir)" >"$(state_file)"
	echo "Bash commands in $(project_dir) now run on box $box."
	echo "Local files are not copied there; the box starts in an empty $(project_dir)."
}

cmd_off() {
	local box
	box="$(current_box)"
	rm -f "$(state_file)"
	if [[ -n "$box" ]]; then
		echo "Bash commands run locally again. Box $box is still there (boxctl rm $box to destroy it)."
	else
		echo "Bash commands already run locally."
	fi
}

cmd_status() {
	local box
	box="$(current_box)"
	if [[ -z "$box" ]]; then
		echo "off: Bash commands in $(project_dir) run locally."
	else
		echo "on: Bash commands in $(project_dir) run on box $box ($(box_state "$box"))."
	fi
}

# remote_script wraps the user's command for the box. Each exec is a
# fresh, non-interactive shell, so the working directory is carried over
# in a file on the box (written on exit, so `exit 3` keeps it too); the
# first command starts in the same absolute path as the local project, so
# paths Claude already knows mean the same thing on both sides.
remote_script() {
	local cwd="$1" b64="$2"
	cat <<EOF
__f=\$HOME/.claude-boxctl-cwd
__d=\$(cat "\$__f" 2>/dev/null) || __d='${cwd//\'/\'\\\'\'}'
mkdir -p "\$__d" && cd "\$__d" || exit 1
trap 'pwd >"\$__f"' EXIT
eval "\$(printf %s '$b64' | base64 -d)"
EOF
}

cmd_run() {
	local timeout="$1" cwd="$2" b64="$3" box out err rc
	box="$(current_box)"
	if [[ -z "$box" ]]; then
		echo "boxctl: remote bash is off for this project" >&2
		return 1
	fi
	out="$(mktemp)" err="$(mktemp)"
	for attempt in 1 2; do
		rc=0
		boxctl ssh "$box" -T "${timeout}s" -- "$(remote_script "$cwd" "$b64")" >"$out" 2>"$err" || rc=$?
		# The idle reaper may have paused the box since the last command.
		if [[ $attempt -eq 1 && $rc -ne 0 ]] && grep -q 'must be running and ready' "$err"; then
			ensure_running "$box"
			continue
		fi
		break
	done
	cat "$out"
	cat "$err" >&2
	rm -f "$out" "$err"
	return "$rc"
}

case "${1:-}" in
on) shift; cmd_on "$@" ;;
off) cmd_off ;;
status) cmd_status ;;
box) current_box ;;
run) shift; cmd_run "$@" ;;
*)
	sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
	;;
esac
